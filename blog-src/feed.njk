---
permalink: feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/blog/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/blog/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}/blog/</id>
  <icon>{{ site.url }}/img/lynxdb-appicon-moss.svg</icon>
  <updated>{{ collections.posts | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  {%- for post in collections.posts %}
  {%- set url = site.url + '/blog' + post.url %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ url }}" rel="alternate" type="text/html"/>
    <id>{{ url }}</id>
    <published>{{ post.date | dateToRfc3339 }}</published>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    {%- for name in post.data.authors %}
    <author><name>{{ name }}</name></author>
    {%- endfor %}
    {%- for tag in post.data.tags %}
    <category term="{{ tag }}"/>
    {%- endfor %}
    <summary>{{ post.data.excerpt }}</summary>
    <content type="html">{{ post.content | feedHtml | htmlToAbsoluteUrls(url) }}</content>
  </entry>
  {%- endfor %}
</feed>
