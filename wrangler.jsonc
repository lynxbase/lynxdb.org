// lynxdb.org on Cloudflare: a Worker serving what mise run dist stages into dist/, with a script for
// the home page and the blog (worker/index.js: AI agents read them as Markdown). .github/workflows/deploy.yml
// deploys it on every tag.
{
  "name": "lynxdb-org",
  "compatibility_date": "2026-11-23",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // the script runs for the pages with a Markdown copy; the rest are served from the assets without it
    "run_worker_first": ["/", "/blog", "/blog/*"],
    // an address with no file gets 404.html with status 404, never the home page
    "not_found_handling": "404-page",
    // pages are folders, served at /blog/slug/; the Markdown copies are files, served as named
    "html_handling": "auto-trailing-slash"
  },
  // the addresses it answers on; a deploy creates their DNS records and certificates. lynxdb.org is
  // canonical: every page names it in <link rel="canonical">, www.lynxdb.org serves the same files.
  "routes": [
    { "pattern": "lynxdb.org", "custom_domain": true },
    { "pattern": "www.lynxdb.org", "custom_domain": true }
  ],
  // no second copy of the site on workers.dev or on preview addresses
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs: each Markdown answer logs the page and the agent that asked for it
  "observability": { "enabled": true }
}
