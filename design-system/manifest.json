      "summary": "One or two words of state or metadata in the label style."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "A sans, sentence-case action on a 6px radius."
    },
    {
      "name": "Callout",
      "group": "Content",
      "summary": "A short aside in running docs text."
    },
    {
      "name": "CliOutput",
      "group": "Examples",
      "summary": "What lynxdb prints: a result table, a query error with a hint, a status view, the same view without colour, and help.",
      "page": true
    },
    {
      "name": "CodeBlock",
      "group": "Content",
      "summary": "LynxFlow and shell text on bg-sunken, in the code style."
    },
    {
      "name": "Console",
      "group": "Examples",
      "summary": "The Web UI query console in the dark theme: field list, LynxFlow editor, event histogram and log rows.",
      "page": true
    },
    {
      "name": "DataTable",
      "group": "Data",
      "summary": "Aggregated results: one row per group, columns typed."
    },
    {
      "name": "DocsPage",
      "group": "Examples",
      "summary": "A documentation page in the light theme: section nav, a prose column capped at measure, a migration table, a code block and an on-page index.",
      "page": true
    },
    {
      "name": "Histogram",
      "group": "Data",
      "summary": "Event volume over time as plain bars."
    },
    {
      "name": "Homepage",
      "group": "Examples",
      "summary": "Homepage variant A, always dark: a two-line statement about log search, the JSONBench comparison as proof, a tabbed search-to-analytics demo, how block skippin…",
      "page": true
    },
    {
      "name": "HomepageB",
      "group": "Examples",
      "summary": "Homepage variant B, light: the hero is a product window that answers PPL queries over 240 sample events in the browser, and the page can be driven from the key…",
      "page": true
    },
    {
      "name": "HomepageBDark",
      "group": "Examples",
      "summary": "Homepage variant B on a dark ground.",
      "page": true
    },
    {
      "name": "Input",
      "group": "Forms",
      "summary": "A bordered field on bg-surface with a border-control edge that holds 3:1 in both themes."
    },
    {
      "name": "LogLevel",
      "group": "Status",
      "summary": "The level word of a log event, coloured by its level-* token."
    },
    {
      "name": "LogTable",
      "group": "Data",
      "summary": "Raw events, one per 22px row: time, level, source, message."
    },
    {
      "name": "Logo",
      "group": "Brand",
      "summary": "The mark, the wordmark and their lockups on light, dark and moss grounds, with size guidance and app icons.",
      "page": true
    },
    {
      "name": "ScrambleText",
      "group": "Motion",
      "summary": "A hover and focus effect for short mono labels and figures on the site: letters and digits are searched glyph by glyph and resolve left to right."
    },
    {
      "name": "Tabs",
      "group": "Navigation",
      "summary": "Views of the same data, labelled in the label style with a 2px accent underline on the selected tab."
    },
    {
      "name": "Terminal",
      "group": "Content",
      "summary": "A shell session, always dark."
    }
